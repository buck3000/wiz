# Stripe API keys (from https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Wiz license signing key (hex-encoded, same as WIZ_SIGNING_KEY_HEX in goreleaser)
WIZ_SIGNING_KEY_HEX=your-production-signing-key-hex

# Stripe Price ID for Pro tier — one-time payment (from Stripe Dashboard > Products)
STRIPE_PRO_PRICE_ID=price_1SwBvNJoQL6k6rZm5JLlO9wi

# Server port (default: 8080)
PORT=8080
